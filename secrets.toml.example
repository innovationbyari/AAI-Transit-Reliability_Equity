# Copy to .streamlit/secrets.toml for local runs, or paste into the app's Settings → Secrets on Streamlit Community Cloud.
# Every key is optional: without keys the app uses documented sample data and template text.

OPENAI_API_KEY = ""          # default LLM provider (narratives only; never used in a score or decision)
OPENROUTER_API_KEY = ""      # LLM fallback 1
HF_API_KEY = ""              # LLM fallback 2
NJ_TRANSIT_USERNAME = ""     # NJ Transit developer portal login, for live GTFS-realtime
NJ_TRANSIT_PASSWORD = ""
CENSUS_API_KEY = ""          # optional; the Census API works without one at lower rate limits
NWS_CONTACT_EMAIL = ""       # identifies the project to the National Weather Service
